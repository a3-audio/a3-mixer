firmware/.pio
# Der Eintrag lautete `engine/scripts/a3-mixer-set-display/__pycache__` und
# zeigte damit auf einen Ordner, den es seit der Umbenennung nach `software/`
# nicht mehr gibt -- also lag der Bytecode unignoriert herum.
__pycache__/
*.pyc

# The one truth's copy, put here at deploy -- see README, "Addresses and ports".
software/scripts/a3-osc.json

# CAD backups and caches: KiCad and FreeCAD write them on their own, they are not sources
**/*-backups/
**/*.kicad_*-bak
**/fp-info-cache
**/_autosave-*
**/~*.lck
**/*.FCBak
**/*.FCStd1
