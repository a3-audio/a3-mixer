"""An offline copy of the OSC truth, for the tests.

    a3-offline-truth <truth> <copy>

The same addresses and ports; every named host except "local" and "any"
moved to 192.0.2.x, the documentation range that routes nowhere. On the rig
the installed truth names the live Core, and the suite used to send
positions and 3D/FREQ/Q there (#67). The test runner refuses every OSC
sender on its own; this is the second wall. Used by test.sh and by
ui/packaging/stage build --test.
"""

import copy
import json
import sys

KEPT = ("local", "any")


def offline(truth):
    moved = copy.deepcopy(truth)
    names = [name for name in moved.get("hosts", {}) if name not in KEPT]
    for number, name in enumerate(names, start=10):
        moved["hosts"][name] = f"192.0.2.{number}"
    return moved


def main(argv):
    source, target = argv[1], argv[2]
    with open(source) as handle:
        truth = json.load(handle)
    with open(target, "w") as handle:
        json.dump(offline(truth), handle, indent=2)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
