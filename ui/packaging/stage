#
# The virtual desk's recipe for its Debian package (a3-desk), called by
# a3-system's installer/package.py from an exported tree (git archive), never
# the checkout:
#
#   ui/packaging/stage build <src> <build> <juce-prefix> <jobs> [--test]
#   ui/packaging/stage files <src> <build> <stage>
#
# `build` compiles ui/ in <build>; `files` lays out the package tree under
# <stage> (the builder adds DEBIAN/). Neither writes anywhere else. No unit:
# the desk is an app a person opens.
set -euo pipefail

usage() {
    echo "usage: $0 build <src> <build> <juce> <jobs> [--test] | files <src> <build> <stage>" >&2
    exit 2
}

# The builder keeps <build> between commits. One configured from another
# source folder (app/, before the desk became ui/ on 2026-10-31) is refused
# by cmake, so its cache goes; the objects stay for ccache and make.
forget_other_source() {
    local build=$1 source=$2
    [[ -f "$build/CMakeCache.txt" ]] || return 0
    grep -qxF "CMAKE_HOME_DIRECTORY:INTERNAL=$source" "$build/CMakeCache.txt" && return 0
    rm -rf "$build/CMakeCache.txt" "$build/CMakeFiles"
}

build() {
    [[ $# -eq 4 || ( $# -eq 5 && "$5" == --test ) ]] || usage
    local src=$1 build=$2 juce=$3 jobs=$4 test=${5:-}
    local tests=OFF
    [[ "$test" == --test ]] && tests=ON
    forget_other_source "$build" "$src/ui"
    cmake -S "$src/ui" -B "$build" -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_PREFIX_PATH="$juce" -DA3DESK_TESTS="$tests"
    cmake --build "$build" -j "$jobs"
    if [[ "$tests" == ON ]]; then
        (cd "$src/software" && PYTHONDONTWRITEBYTECODE=1 python3 -m unittest discover -s tests -p 'test_desk_cases.py')
        local truth="${A3_OSC_TRUTH:-/usr/share/a3/a3-osc.json}"
        export A3_OSC_TRUTH="$build/a3-osc-offline.json"
        python3 -I "$src/ui/tools/a3-offline-truth" "$truth" "$A3_OSC_TRUTH"
        xvfb-run -a ctest --test-dir "$build" --output-on-failure
    fi
}

files() {
    [[ $# -eq 3 ]] || usage
    local src=$1 build=$2 stage=$3
    install -D -m 755 "$build/A3Desk_artefacts/Release/A3 Desk" "$stage/usr/bin/a3-desk"
    install -D -m 644 "$src/ui/packaging/a3-desk.desktop" "$stage/usr/share/applications/a3-desk.desktop"
    # .reuse/dep5 is already in Debian's machine-readable copyright format.
    install -D -m 644 "$src/.reuse/dep5" "$stage/usr/share/doc/a3-desk/copyright"
}

case "${1:-}" in
    build) shift; build "$@" ;;
    files) shift; files "$@" ;;
    *) usage ;;
esac
